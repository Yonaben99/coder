# Portfolio Command Center — environment variables
# Copy to .env (repo root) and fill in real values for apps/api. Never commit .env.
# All of these are server-side only (read by apps/api). None are exposed to
# the frontend bundle. The frontend's one (non-secret) env var,
# NEXT_PUBLIC_API_BASE_URL, lives in apps/web/.env.local instead — see README.md.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_command_center

# --- Session / auth ---
SESSION_SECRET=replace-with-a-long-random-value-at-least-16-characters

# --- IBKR Client Portal Gateway ---
# The gateway itself handles the browser-based login (username/password/2FA);
# the backend only needs to know where to reach it. No IBKR credentials are
# ever stored in this application — see SECURITY.md.
IBKR_GATEWAY_BASE_URL=https://localhost:5000/v1/api

# --- OpenAI ---
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-chosen-model-id

# --- Market data / news vendor (choose one; finalized in Phase 4) ---
MARKET_INTEL_PROVIDER=fmp
MARKET_INTEL_API_KEY=replace-with-your-provider-api-key

# --- Monitoring (optional, wired in Phase 6) ---
SENTRY_DSN=

# --- App ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
