# apps/web environment variables — copy to apps/web/.env.local for local dev.
#
# Next.js only exposes variables prefixed NEXT_PUBLIC_ to the browser bundle
# — this is the one such variable this app has, and it is not a secret (it's
# just the API's own public URL). Never put a real secret behind a
# NEXT_PUBLIC_ prefix. See SECURITY.md §1.

# Where the browser sends API requests. In production this is the deployed
# backend's public HTTPS URL (see docs/DEPLOYMENT.md); it is baked into the
# JS bundle at build time, not read at runtime, so set it before running
# `next build` for a production deploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
