# Portfolio Command Center — PRODUCTION environment variables
#
# This file documents what apps/api needs when NODE_ENV=production. It is a
# reference, not something to copy verbatim into a real deploy — set these
# as actual secrets in your hosting provider's environment/secrets manager
# (see docs/DEPLOYMENT.md), never as a committed file. Never reuse dev/test
# values here: a production SESSION_SECRET or DATABASE_URL that leaked into
# a dev machine or a Slack message is a production secret to rotate, not a
# convenience to keep.
#
# The zod config schema (apps/api/src/config.ts) enforces two of these
# rules at startup, not just in this comment: in production the app refuses
# to start with a SESSION_SECRET under 32 characters or an APP_BASE_URL
# that isn't https://.

# --- Runtime ---
NODE_ENV=production
PORT=4000

# --- Database ---
# Managed Postgres connection string from your hosting provider. Include
# `?sslmode=require` (or the provider's documented equivalent) — most
# managed Postgres offerings require or strongly recommend TLS in transit.
DATABASE_URL=postgresql://user:password@your-db-host:5432/portfolio_command_center?sslmode=require

# --- Session / auth ---
# Generate with: openssl rand -base64 48
# Must be at least 32 characters — the app will refuse to start otherwise.
SESSION_SECRET=replace-with-a-freshly-generated-secret-at-least-32-characters

# --- App ---
# The frontend's real production URL. Must be https:// — the app will
# refuse to start otherwise. Used for CORS (exact-origin allowlist) and as
# the origin state-changing cookie-authenticated requests are checked
# against. See SECURITY.md §4.
APP_BASE_URL=https://your-production-domain.example.com

# --- IBKR Client Portal Gateway ---
# Points the backend at wherever the gateway process runs in production
# (same host as the backend, or a private network address the backend can
# reach). The gateway itself still requires the user's own browser-based
# login — see docs/IBKR_INTEGRATION.md and SECURITY.md §2. Leave unset to
# deploy without IBKR connected yet; the app shows an honest NOT_CONFIGURED
# state rather than failing to start.
IBKR_GATEWAY_BASE_URL=

# --- OpenAI (Portfolio AI) ---
# Intentionally left unset for the initial production deployment (Phase 7).
# The app starts and runs correctly without it — AI Chat and every AI tool
# honestly report "not connected" instead of failing. Add it later per
# docs/OPENAI_INTEGRATION.md and this file's own comments once you're ready
# to connect a real OpenAI account. Never commit a real key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Market data (not yet implemented) ---
MARKET_INTEL_PROVIDER=
MARKET_INTEL_API_KEY=

# --- News / analysts / earnings (Finnhub) ---
# Intentionally left unset for the initial production deployment (Phase 7).
# News, Analysts, Catalysts, and Earnings all show honest NOT_CONFIGURED
# states without it. Add it later per docs/NEWS_INTEGRATION.md and
# docs/RISK_AND_CATALYSTS.md once you're ready to connect a real Finnhub
# account. Never commit a real key here.
FINNHUB_API_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=
